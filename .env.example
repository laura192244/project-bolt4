# Copy this file to ".env" and fill in your own Supabase project values.
# Find them in Supabase: Project Settings (gear icon) → API.
# The ".env" file is gitignored so your real keys stay private.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
